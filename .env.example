# Flask 应用配置
SECRET_KEY=your-secret-key-here
DEBUG=False
PORT=8080
HOST=0.0.0.0

# 文件上传配置
MAX_CONTENT_LENGTH=16777216

# 日志配置
LOG_DIR=logs
LOG_LEVEL=INFO

# Redis 配置（Celery 消息队列）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# 文件路径配置
UPLOAD_FOLDER=static/uploads
OUTPUTS_FOLDER=static/outputs
